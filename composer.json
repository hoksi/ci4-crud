{
    "name": "hoksi/ci4-crud",
    "description": "CodeIgniter 4 CRUD library — Auto-generate CRUD interfaces with minimal code",
    "type": "library",
    "license": "MIT",
    "keywords": ["codeigniter4", "codeigniter", "crud", "library", "php"],
    "authors": [
        {
            "name": "hoksi",
            "email": "hoksi3k@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Hoksi\\Ci4Crud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hoksi\\Ci4Crud\\Tests\\": "tests/"
        }
    }
}
